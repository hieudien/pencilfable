# Copy to .env.local and fill in. All values are public (they ship in the browser bundle).
VITE_APP_NAME=Pencilfable
# The public address of the site (no trailing slash). Used for canonical links, sitemap.xml and share previews.
VITE_SITE_URL=https://pencilfable.pages.dev
VITE_SUPPORT_EMAIL=

# Where the "Donate" buttons lead: your Ko-fi / Buy Me a Coffee / PayPal.me / GitHub Sponsors page.
# Leave empty and the donate page says donations are not open yet.
VITE_DONATE_URL=
# Name of that service, shown on the donate page (e.g. Ko-fi)
VITE_DONATE_PROVIDER=

# Shown on the Privacy and Terms pages ("Operated by ...")
VITE_OPERATOR_NAME=
VITE_OPERATOR_COUNTRY=Vietnam
# Optional: a short personal note on the donate page, e.g. "I'm a former teacher and I built this to save you time."
VITE_OPERATOR_BIO=
